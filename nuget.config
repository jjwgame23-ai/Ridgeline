<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Godot's .NET packages (Godot.NET.Sdk, GodotSharp, Godot.SourceGenerators) are published on nuget.org for every
      release, so a clean checkout restores from there alone: no Godot install needed to build. (This used to point at
      the nupkgs folder inside a local Godot install as well, and restore failed on any machine without that folder.)
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
